# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ticket_booking

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this

# Server
PORT=3000
FRONTEND_URL=http://localhost:5173

# Seat hold TTL (minutes)
HOLD_TTL_MINUTES=10

# Waitlist offer TTL (minutes)
OFFER_TTL_MINUTES=30

# Email (Resend)
RESEND_API_KEY=re_your_resend_api_key
FROM_EMAIL=tickets@yourdomain.com

# Sweep job interval (milliseconds)
SWEEP_INTERVAL_MS=3000
