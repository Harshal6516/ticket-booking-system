# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/ticket_booking

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-this

# Server Configuration
PORT=3000
FRONTEND_URL=http://localhost:5173

# Seat Hold TTL (minutes)
HOLD_TTL_MINUTES=10

# Waitlist Offer TTL (minutes)
OFFER_TTL_MINUTES=30

# Background Sweep Interval (milliseconds)
SWEEP_INTERVAL_MS=3000

# Email (SMTP / Nodemailer Configuration)
# Leave SMTP_HOST blank to automatically use Ethereal test inbox in development (preview URL in console).
# To send real emails via Gmail, Brevo, SendGrid, Mailgun, AWS SES, or any SMTP provider:
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=tickets@tickethub.local
FROM_NAME=TicketHub
